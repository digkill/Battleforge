# Используется docker-compose.yml (docker compose читает .env из корня проекта).

# Секретный ключ игры из Студии Pikabu (Раздел SDK → Верификация). Обязателен.
PIKABU_SECRET_KEY=

# Адрес backend, доступный из БРАУЗЕРА пользователя (не docker-сети) —
# встраивается в статический фронтенд-бандл на этапе сборки.
VITE_API_URL=http://localhost:8080

# Порты на хосте (необязательно, значения по умолчанию ниже)
BACKEND_PORT=8080
FRONTEND_PORT=5183
